{
  "name": "bubble-harness",
  "version": "0.1.0-dev",
  "description": "Lightweight agent harness for constrained JavaScript runtimes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agent",
    "harness",
    "openrouter",
    "chrome-extension",
    "constrained-runtime"
  ],
  "author": "Airic Yu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airicyu/bubble-harness.git"
  },
  "bugs": {
    "url": "https://github.com/airicyu/bubble-harness/issues"
  },
  "homepage": "https://github.com/airicyu/bubble-harness#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "private": false
}
